{
  "name": "dsh-folio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Folio — a LaTeX writing workspace for DeepSeek Harness: source editor, PDF builds, and AI edits you review, through the native Harness chat.",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "domain.js",
    "compiler.js",
    "proposals.js",
    "tex.js",
    "synctex.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "scripts": {
    "build": "node build-client.mjs",
    "test": "node --test \"test/*.test.js\"",
    "prepack": "node build-client.mjs"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "latex",
    "editor",
    "pdf",
    "ai-writing"
  ],
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/language": "^6.12.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.13",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "diff": "^5.2.2",
    "esbuild": "^0.21.5",
    "pdfjs-dist": "^4.10.38"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meinianda-L/folio.git"
  },
  "homepage": "https://github.com/Meinianda-L/folio#readme"
}
